<Window x:Class="DailyPlanner.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:svc="clr-namespace:DailyPlanner.Services"
        Title="Command palette"
        Width="640" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding ExecuteSelectedCommand}"/>
        <KeyBinding Key="Down" Command="{Binding MoveSelectionDownCommand}"/>
        <KeyBinding Key="Up" Command="{Binding MoveSelectionUpCommand}"/>
    </Window.InputBindings>

    <Border Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="40" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search row -->
            <Grid Grid.Row="0" Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="18"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBox Grid.Column="1"
                         x:Name="QueryBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontSans}"
                         FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         Padding="0"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource SubtleBgBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="6,2">
                    <TextBlock Text="ESC" Style="{StaticResource MicroLabelDim}"/>
                </Border>
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                    Background="{DynamicResource GlassBorderBrush}" Opacity="0.4"/>

            <!-- Action list -->
            <ListBox Grid.Row="1"
                     x:Name="ActionList"
                     ItemsSource="{Binding Filtered}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="10,6"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Padding="14,12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleBgBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="32" Height="32"
                                    Background="{DynamicResource SubtleBgBrush}"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Hint}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HasHint, Converter={StaticResource VisConv}}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource SubtleBgBrush}"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasShortcut, Converter={StaticResource VisConv}}">
                                <TextBlock Text="{Binding Shortcut}"
                                           Style="{StaticResource MicroLabelDim}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="{Binding [CmdNoResults], Source={x:Static svc:Loc.Instance}}"
                       Style="{StaticResource MicroLabelDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasResults, Converter={StaticResource InvVisConv}}"/>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SubtleBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10"
                    CornerRadius="0,0,22,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="↑↓" Style="{StaticResource MicroLabelDim}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding [CmdNavigate], Source={x:Static svc:Loc.Instance}}"
                                   Style="{StaticResource MicroLabelDim}" Margin="0,0,18,0"/>
                        <TextBlock Text="↵" Style="{StaticResource MicroLabelDim}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding [CmdRun], Source={x:Static svc:Loc.Instance}}"
                                   Style="{StaticResource MicroLabelDim}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Ctrl+K"
                               Style="{StaticResource MicroLabelAccent}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
